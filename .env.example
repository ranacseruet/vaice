# Copy to .env, uncomment what you want to change, then start vaice with it loaded:
#   set -a; source .env; set +a; .venv/bin/vaice
# vaice does not read .env itself. The active settings below are built-in defaults.

# Realtime is the historical default. `text` uses local sherpa-onnx Whisper/Kokoro and an
# OpenAI-compatible /v1/chat/completions endpoint. `auto` requires verified realtime capabilities.
# VAICE_PIPELINE=realtime

# Realtime llama-server URL. Only scheme://host:port is used; text mode uses this by default.
# VAICE_LLAMACPP_URL=http://localhost:8001
# Optional OpenAI API base URL for text mode; its path is preserved (normally ends in /v1).
# Defaults to VAICE_LLAMACPP_URL plus /v1.
# VAICE_TEXT_URL=http://localhost:8001/v1
# Realtime mode line is added before this prompt. In text mode this prompt is sent as system content.
# VAICE_LLAMACPP_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."
# VAICE_TEXT_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."
# Optional model name for /chat/completions; otherwise vaice discovers it from /models.
# VAICE_TEXT_MODEL=
# Seconds: to open the connection, and the longest silence from llama-server before a realtime reply fails.
# VAICE_LLAMACPP_TIMEOUT=120
# Older aliases still work: VAICE_LLM_URL / VAICE_LLM_PROMPT / VAICE_PROMPT / VAICE_LLM_TIMEOUT.
# VAICE_LLM_MODEL and the old VAICE_TTS_* / VAICE_VOICE / VAICE_SPEED settings were removed and stay ignored.

# Optional local speech pipeline dependencies: uv pip install -e ".[local-voice]"
# Whisper Tiny model files (encoder, decoder, tokens) are loaded on the first text turn.
# VAICE_WHISPER_MODEL_DIR=~/.vaice/models/sherpa-onnx-whisper-tiny
# The file paths can be overridden individually if your model directory uses other names.
# VAICE_WHISPER_ENCODER=
# VAICE_WHISPER_DECODER=
# VAICE_WHISPER_TOKENS=
# Leave empty for automatic language detection.
# VAICE_WHISPER_LANGUAGE=

# Kokoro English files (model, voices, tokens, espeak-ng-data, lexicon) are loaded on the first text turn.
# VAICE_KOKORO_MODEL_DIR=~/.vaice/models/kokoro-en-v0_19
# VAICE_KOKORO_MODEL=~/.vaice/models/kokoro-en-v0_19/model.onnx
# VAICE_KOKORO_VOICES=~/.vaice/models/kokoro-en-v0_19/voices.bin
# VAICE_KOKORO_TOKENS=~/.vaice/models/kokoro-en-v0_19/tokens.txt
# VAICE_KOKORO_DATA_DIR=~/.vaice/models/kokoro-en-v0_19/espeak-ng-data
# VAICE_KOKORO_LEXICON=~/.vaice/models/kokoro-en-v0_19/lexicon-en-us.txt
# VAICE_KOKORO_SPEAKER=0
# VAICE_KOKORO_SPEED=1.0
# VAICE_TTS_MODEL / VAICE_TTS_VOICE / VAICE_TTS_SPEED / VAICE_VOICE / VAICE_SPEED are removed and ignored.

# UI port, conversation storage, and history window.
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice
# VAICE_HISTORY_TURNS=10

# VAICE_BACKEND and --backend were removed; if VAICE_BACKEND is set, startup fails with migration guidance.
# VAICE_NATIVE_MODEL and VAICE_NATIVE_PROMPT were removed and have no effect.
