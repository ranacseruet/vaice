# Copy to .env in the directory you launch vaice from, and uncomment what you want to change:
#   .venv/bin/vaice
# vaice loads .env from the working directory at startup; variables already in the environment
# (e.g. `set -a; source .env; set +a; .venv/bin/vaice`) win over the file. The active settings
# below are built-in defaults.

# llama.cpp llama-server (b11960+) with an audio-output model. Only scheme://host:port of the URL is used.
# VAICE_LLAMACPP_URL=http://localhost:8001

# Reply instructions; the mode line "Respond with interleaved text and audio." is added in front by vaice.
# VAICE_LLAMACPP_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."

# Seconds to open the connection, and the longest silence from llama-server before the reply fails.
# VAICE_LLAMACPP_TIMEOUT=120

# Reply cap: text tokens and audio frames count together (the LFM3-Audio codec emits 12 tokens per
# 80 ms of speech, so 1024 is a couple of spoken sentences). The model card's example uses 1024.
# VAICE_LLAMACPP_MAX_OUTPUT_TOKENS=1024

# UI port, and where conversation.json is kept.
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice

# Past exchanges included in each prompt (0 = none).
# VAICE_HISTORY_TURNS=10

# fastrtc's Silero VAD: what counts as speech, and when an utterance ends. A barge-in fires when
# the interrupting sound ends, so the threshold decides what can interrupt a playing reply —
# raise it (e.g. 0.7) if room noise or speaker feedback cuts replies short.
# VAICE_VAD_THRESHOLD=0.6
# VAICE_VAD_MIN_SILENCE_MS=150
# VAICE_VAD_SPEECH_PAD_MS=30

# Set to 0 to disable barge-in entirely: a reply always runs to the end.
# VAICE_CAN_INTERRUPT=1
