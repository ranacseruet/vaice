# Copy to .env in the directory you launch vaice from, and uncomment what you want to change:
#   .venv/bin/vaice        (or .venv/bin/vaice up, to start llama-server too)
# vaice loads .env from the working directory at startup; variables already in the environment
# (e.g. `set -a; source .env; set +a; .venv/bin/vaice`) win over the file. The active settings
# below are built-in defaults.

# llama.cpp llama-server (b11960+) with an audio-output model. Only scheme://host:port of the URL is used.
# VAICE_LLAMACPP_URL=http://localhost:8001

# `vaice up` only: when no llama-server answers at the URL above (it must be local), vaice starts
#   llama-server -hf <model> --temp 0 --host <host> --port <port> <server args>
# and stops it again at exit; output goes to <VAICE_DATA_DIR>/llama-server.log. The server args are
# split like a shell would (e.g. --ctx-size 16384). The start timeout is in seconds: the
# first run downloads about 2.4 GB.
# VAICE_LLAMACPP_MODEL=LiquidAI/LFM3-Omni-2B-GGUF:Q8_0
# VAICE_LLAMACPP_SERVER_ARGS=
# VAICE_LLAMACPP_START_TIMEOUT=900

# The reply instructions (the system prompt). vaice adds the realtime mode line, the earlier turns, the current
# date and time and the memory notes. If you replace it, keep its last sentence ("... use the tool again, even
# if you answered the same kind of question earlier."): without it the model answers "what do you see now?" from
# its earlier answer instead of looking again.
# VAICE_PROMPT="You are a voice assistant on the user's Mac. ... use the tool again, even if you answered the same kind of question earlier."

# Seconds to open the connection, and the longest silence from llama-server before the reply fails.
# VAICE_LLAMACPP_TIMEOUT=120

# Reply cap: text tokens and audio frames count together (the LFM3-Audio codec emits 12 tokens per
# 80 ms of speech, so 1024 is a couple of spoken sentences). The model card's example uses 1024.
# VAICE_LLAMACPP_MAX_OUTPUT_TOKENS=1024

# A skill's result goes back to the model as text and it tends to read it aloud. Each string value and
# the whole compacted result are capped: too small cuts the answer (the end of a long list, the
# end of a file); too large makes the model dictate the result. Raise only if answers are missing.
# VAICE_LLAMACPP_TOOL_VALUE_CHARS=200
# VAICE_LLAMACPP_TOOL_OUTPUT_CHARS=800

# Adds the run_shell skill: a shell command the assistant proposes runs only after you press Run (sudo is
# refused), with vaice's own permissions. Off by default.
# VAICE_SHELL=false
# Long-term memory: the assistant keeps short notes you ask it to ("remember that I park on level three"),
# in <VAICE_DATA_DIR>/memory.json, and uses them in every later conversation; "forget ..." deletes
# them, "forget everything" needs the Run button. Nothing is saved unless you ask. Off by default (with the local
# 2B model an extra tool costs accuracy on other requests); off = the skills do not exist and the file is not read.
# VAICE_MEMORY=false

# The look_at_screen skill. Set the URL of a vision model (any OpenAI-compatible
# endpoint that takes images, /v1 included; the default LFM3-Omni-2B reads images, so the llama-server above
# can be the vision model too: http://localhost:8001/v1) and asking about your
# screen takes one screenshot of the main display and sends it there. Off by default (unset = no
# screenshot is ever taken). macOS needs Screen Recording permission for the app that runs vaice
# (your terminal); restart it after granting. PRIVACY: a host that is not on this machine receives
# an image of your screen. The key is a secret: vaice never logs it. The
# timeout is in seconds.
# VAICE_VISION_URL=http://localhost:8001/v1
# VAICE_VISION_MODEL=
# VAICE_VISION_API_KEY=your-key-here
# VAICE_VISION_TIMEOUT=30
# Cap on the vision model's answer, in tokens (0 = send none). Without one a busy screen took 5 to 9 s to describe.
# VAICE_VISION_MAX_TOKENS=200

# MCP tools. A JSON file in Claude Desktop's mcpServers shape (stdio servers only:
# command, args, env, cwd) plus a "tools" key per server that lists the tools to offer and how each
# is approved: "run" (at once) or "click" (only the Run button; the default, and what a plain list
# means). Unlisted tools are never offered. Needs the optional extra: uv sync --extra mcp.
# Do not configure a browser server (chrome-devtools-mcp) here: the browser is used through
# VAICE_BROWSE below. SAFETY: each server is a program vaice starts with your permissions. env values
# in the file are secrets: keep it private; vaice never logs them. The timeout (seconds, > 0) bounds a server's start and, separately, each call.
# VAICE_MCP_CONFIG=~/.vaice/mcp.json
# VAICE_MCP_TIMEOUT=30

# browse(goal), a task in a real Chrome window done in the background by a browser agent that vaice speaks ACP
# to. `off` (default), `pi` or `acp`. Both need Node.js (`npx` on PATH) and the optional extra:
# uv sync --extra browse.
#   pi:  the Pi coding agent (https://pi.dev; install it yourself, version 1.5.2 or newer, `pi` on PATH) through
#        pi-acp. Needs VAICE_BROWSE_URL: Pi has an endpoint, model and key of its own (OpenAI-compatible, base
#        URL with /v1). The key is a secret: it reaches Pi's environment only.
#   acp: any ACP agent, the command line in VAICE_BROWSE_AGENT (it has its own model and login, so the
#        VAICE_BROWSE_URL/MODEL/API_KEY settings are ignored). It runs with your environment minus every VAICE_*
#        variable. vaice only gates what the agent asks about: its own tools and permission mode are its config's.
# Pages' text goes to the agent's endpoint. Chrome gets a profile of its own in VAICE_DATA_DIR/browse (logins
# persist there). A step that changes a page needs the Run button. A task is stopped after VAICE_BROWSE_SECONDS;
# VAICE_BROWSE_HEADLESS=1 hides the window.
# VAICE_BROWSE=pi
# VAICE_BROWSE_URL=http://localhost:1234/v1
# VAICE_BROWSE_MODEL=your-model-id
# VAICE_BROWSE_API_KEY=your-key-here
# VAICE_BROWSE_SECONDS=180
# VAICE_BROWSE_HEADLESS=0
# VAICE_BROWSE=acp
# VAICE_BROWSE_AGENT=opencode acp   # works, but OpenCode does not ask before every browser step (docs/browser-tasks.md)
# `off` lets the browser agent click, type and submit forms without asking (`ask`, the default, asks for each such step).
# VAICE_BROWSE_CONFIRM=ask

# UI port, and where conversation.json (and memory.json, the assistant's notes) is kept. Set it empty
# (VAICE_DATA_DIR=) to keep the conversation and the notes in memory only: nothing is read from or written to disk.
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice

# Past exchanges included in each prompt (0 = none).
# VAICE_HISTORY_TURNS=10

# fastrtc's Silero VAD: what counts as speech, and when an utterance ends. A barge-in fires when
# the interrupting sound ends, so the threshold decides what can interrupt a playing reply —
# raise it (e.g. 0.7) if room noise or speaker feedback cuts replies short.
# VAICE_VAD_THRESHOLD=0.6
# VAICE_VAD_MIN_SILENCE_MS=150
# VAICE_VAD_SPEECH_PAD_MS=30

# Set to 0 to disable barge-in entirely: a reply always runs to the end.
# VAICE_CAN_INTERRUPT=1
