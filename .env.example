# Copy to .env in the directory you launch vaice from, and uncomment what you want to change:
#   .venv/bin/vaice        (or .venv/bin/vaice up, to start llama-server too)
# vaice loads .env from the working directory at startup; variables already in the environment
# (e.g. `set -a; source .env; set +a; .venv/bin/vaice`) win over the file. The active settings
# below are built-in defaults.

# llama.cpp llama-server (b11960+) with an audio-output model. Only scheme://host:port of the URL is used.
# VAICE_LLAMACPP_URL=http://localhost:8001

# `vaice up` only: when no llama-server answers at the URL above (it must be local), vaice starts
#   llama-server -hf <model> --temp 0 --host <host> --port <port> <server args>
# and stops it again at exit; output goes to <VAICE_DATA_DIR>/llama-server.log. The server args are
# split like a shell would (e.g. --tools get_info,read_file). The start timeout is in seconds: the
# first run downloads about 1 GB.
# VAICE_LLAMACPP_MODEL=LiquidAI/LFM3-Audio-2B-GGUF:Q4_K_M
# VAICE_LLAMACPP_SERVER_ARGS=
# VAICE_LLAMACPP_START_TIMEOUT=900

# Reply instructions; the mode line "Respond with interleaved text and audio." is added in front by vaice.
# VAICE_LLAMACPP_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."

# Seconds to open the connection, and the longest silence from llama-server before the reply fails.
# VAICE_LLAMACPP_TIMEOUT=120

# Reply cap: text tokens and audio frames count together (the LFM3-Audio codec emits 12 tokens per
# 80 ms of speech, so 1024 is a couple of spoken sentences). The model card's example uses 1024.
# VAICE_LLAMACPP_MAX_OUTPUT_TOKENS=1024

# Tool results go back to the model as text and it tends to read them aloud. Each string value and
# the whole compacted result are capped: too small cuts the answer (the timestamp in get_info, the
# end of a file); too large makes the model dictate the result. Raise only if answers are missing.
# VAICE_LLAMACPP_TOOL_VALUE_CHARS=200
# VAICE_LLAMACPP_TOOL_OUTPUT_CHARS=800

# Voice access to llama-server's built-in tools: the server must be started with --tools (a
# read-only subset, e.g. --tools get_info,read_file — they run with the server's own permissions,
# so never enable exec_shell_command or write_file for a voice demo). "builtin" takes every tool
# the server advertises; the set is chosen on the server, not here. Unset = no tools. With tools
# on, set a prompt that tells the model to use them, or it usually answers without calling:
# VAICE_LLAMACPP_PROMPT="Use the available tools to answer questions about this system."
# VAICE_LLAMACPP_TOOLS=builtin

# Assistant mode: transcribe, a brain that can call vaice's own skills (disk, battery, system,
# processes, files, open/quit app, volume, mute; macOS only; quitting an app asks
# for a yes first), then llama-server's /tts sentence by sentence. The
# default, chat, is the speech-to-speech reply above. The prompt is the brain's system prompt;
# the voice is female or male.
# VAICE_MODE=assistant
# VAICE_ASSISTANT_PROMPT="You are a voice assistant on the user's Mac. ..."
# VAICE_VOICE=female
# Adds the run_shell skill: a shell command the assistant proposes runs only after you approve
# it (a short list of harmless ones by voice or click, everything else only by the Run button;
# sudo is refused) and with vaice's own permissions. Off by default.
# VAICE_ASSISTANT_SHELL=false

# UI port, and where conversation.json is kept. Set it empty (VAICE_DATA_DIR=) to keep the
# conversation in memory only: nothing is read from or written to disk.
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice

# Past exchanges included in each prompt (0 = none).
# VAICE_HISTORY_TURNS=10

# fastrtc's Silero VAD: what counts as speech, and when an utterance ends. A barge-in fires when
# the interrupting sound ends, so the threshold decides what can interrupt a playing reply —
# raise it (e.g. 0.7) if room noise or speaker feedback cuts replies short.
# VAICE_VAD_THRESHOLD=0.6
# VAICE_VAD_MIN_SILENCE_MS=150
# VAICE_VAD_SPEECH_PAD_MS=30

# Set to 0 to disable barge-in entirely: a reply always runs to the end.
# VAICE_CAN_INTERRUPT=1
