# Copy to .env, uncomment what you want to change, then start vaice with it loaded:
#   set -a; source .env; set +a; .venv/bin/vaice
# vaice does not read .env itself. The active settings below are built-in defaults.

# llama.cpp llama-server (b11960+) with an audio-output model. Only scheme://host:port of the URL is used.
# VAICE_LLAMACPP_URL=http://localhost:8001

# Reply instructions; the mode line "Respond with interleaved text and audio." is added in front by vaice.
# VAICE_LLAMACPP_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."

# Seconds to open the connection, and the longest silence from llama-server before the reply fails.
# VAICE_LLAMACPP_TIMEOUT=120

# UI port, and where conversation.json is kept.
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice

# Past exchanges included in each prompt (0 = none).
# VAICE_HISTORY_TURNS=10
