# Copy to .env, uncomment what you want to change, then start vaice with it loaded:
#   set -a; source .env; set +a; .venv/bin/vaice
# vaice does not read .env itself. Every value below is the built-in default.

# auto | llamacpp | native (the --backend flag overrides this); "cascade" is the old name of llamacpp
# VAICE_BACKEND=auto

# Native backend (mlx-audio speech-to-speech). Empty VAICE_NATIVE_MODEL disables native.
# VAICE_NATIVE_MODEL=mlx-community/LFM2.5-Audio-1.5B-8bit
# VAICE_NATIVE_PROMPT="Respond with interleaved text and audio. Reply naturally and concisely in 1 to 2 spoken sentences."

# llamacpp backend: llama.cpp llama-server (b11960+) with an audio-output model such as LFM3-Audio
# (the only server tested). Only scheme://host:port of the URL is used.
# VAICE_LLAMACPP_URL=http://localhost:8001
# The mode line "Respond with interleaved text and audio." is added in front of this by vaice
# VAICE_LLAMACPP_PROMPT="Reply naturally and concisely in 1 to 2 spoken sentences."
# seconds: to open the connection, and the longest silence from the server before the reply fails
# VAICE_LLAMACPP_TIMEOUT=120
# (the older VAICE_LLM_URL / VAICE_LLM_PROMPT / VAICE_PROMPT / VAICE_LLM_TIMEOUT still work; the name above wins
# if both are set. VAICE_LLM_MODEL and VAICE_TTS_* / VAICE_VOICE / VAICE_SPEED belonged to the Gemma + Kokoro
# pipeline and are ignored now.)

# UI port, and where conversation.json is kept
# VAICE_PORT=7860
# VAICE_DATA_DIR=~/.vaice
# Past exchanges included in each prompt (0 = none)
# VAICE_HISTORY_TURNS=10
