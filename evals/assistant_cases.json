  {"id": "battery-plugged", "say": "Is my laptop plugged in?",
   "expect": {"tools": ["battery_status"]}},
  {"id": "battery-left", "say": "How much battery time do I have left?",
   "expect": {"tools": ["battery_status"]}},
  {"id": "battery-charging", "say": "Is my Mac charging right now?",
   "expect": {"tools": ["battery_status"]}},

  {"id": "system-os", "say": "Which version of macOS am I running?",
   "expect": {"tools": ["system_info"]}},
  {"id": "system-uptime", "say": "How long has my computer been on?",
   "expect": {"tools": ["system_info"]}},
  {"id": "system-memory", "say": "How much memory does this Mac have?",
   "expect": {"tools": ["system_info"]}},

  {"id": "procs-memory", "say": "Which apps are using the most memory?",
