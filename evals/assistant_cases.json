   "expect": {"tools": ["top_processes"], "args": {"top_processes": {"by": "cpu"}}}},
  {"id": "procs-slow", "say": "What's slowing my computer down?",
   "expect": {"tools": ["top_processes"]}},
  {"id": "procs-top-five", "say": "Show me the top five processes by memory.",
   "expect": {"tools": ["top_processes"], "args": {"top_processes": {"by": "memory", "count": 5}}}},

  {"id": "files-resume", "say": "Where did I save my resume?",
   "expect": {"tools": ["find_files"], "args": {"find_files": {"name": "resume"}}}},
  {"id": "files-invoice", "say": "Find the file called invoice in my documents folder.",
   "expect": {"tools": ["find_files"],
              "args": {"find_files": {"name": "invoice", "folder": "documents"}}}},
  {"id": "files-pdf-downloads", "say": "Do I have any PDF files in my downloads?",
