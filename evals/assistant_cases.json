   "expect": {"tools": ["disk_space"]}},
  {"id": "disk-room", "say": "Is there enough room on my Mac to install a big game?",
   "expect": {"tools": ["disk_space"]}},

  {"id": "battery-level", "say": "What's my battery level?",
