  {"id": "files-screenshot", "say": "Is there a screenshot on my desktop?",
   "expect": {"tools": ["find_files"],
              "args": {"find_files": {"name": "screenshot", "folder": "desktop"}}}},

  {"id": "two-disk-battery", "say": "How much disk space is free, and is my laptop plugged in?",
